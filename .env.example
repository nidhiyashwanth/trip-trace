# Optional: enables live Gemini calls. The app is fully runnable without it in demo mode.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# auto uses Gemini when configured and falls back per agent when a call fails.
# demo forces the deterministic local provider; gemini requires a key.
AGENT_MODE=auto

# Where the audit JSON file is stored by the Node API.
DATA_DIR=./data
PORT=8787
